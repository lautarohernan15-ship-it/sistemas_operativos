from pathlib import Path

class Proceso:
    def __init__(self, pid, tamano, arribo, irrupcion):
        self.pid = pid
        self.tamano = int(tamano)
        self.arribo = int(arribo)
        self.irrupcion = int(irrupcion)
        self.restante = int(irrupcion)
        self.estado = "Nuevo"  # Nuevo, Listo, Listo/Suspendido, Ejecución, Terminado
        self.espera = 0
        self.retorno = 0
        self.tiempo_comienzo = -1

class Particion:
    def __init__(self, id_particion, inicio, tamano):
        self.id = id_particion
        self.inicio = inicio
        self.tamano = int(tamano)
        self.pid = None  # None si está libre, o el ID del proceso si está ocupada
        self.fragmentacion_interna = 0

class Simulador:
    def __init__(self, archivo_procesos):
        self.tiempo_actual = 0
        self.procesos = []
        self.memoria_total_usuario = 450
        self.particiones = []
        
        # Colas de estados
        self.cola_nuevo = []
        self.cola_listo = []
        self.cola_listo_suspendido = []
        self.cola_terminado = []
        self.proceso_ejecucion = None

        self.cargar_procesos(archivo_procesos)
        # Inicializar con una única partición libre de 450K para usuarios (a partir de la dirección 100)
        self.particiones.append(Particion(1, 100, self.memoria_total_usuario))

    def cargar_procesos(self, ruta):
        ruta = Path(ruta)
        if not ruta.is_absolute():
            ruta = Path(__file__).resolve().parent / ruta
        with open(ruta, 'a', encoding='utf-8'):
            pass
        with open(ruta, 'r', encoding='utf-8') as f:
            for linea in f:
                partes = [p.strip() for p in linea.split(',')]
                if len(partes) == 4:
                    p = Proceso(partes[0], partes[1], partes[2], partes[3])
                    p.estado = "Nuevo"
                    self.procesos.append(p)
        # Ordenar por tiempo de arribo inicial
        self.procesos.sort(key=lambda x: x.arribo)

    def grado_multiprogramacion_activo(self):
        # Cuenta Ejecución + Listo + Listo/Suspendido
        ejec = 1 if self.proceso_ejecucion else 0
        return ejec + len(self.cola_listo) + len(self.cola_listo_suspendido)

    def asignar_memoria_best_fit(self, proceso):
        mejor_particion = None
        min_espacio_sobrante = float('inf')

        for p in self.particiones:
            if p.pid is None and p.tamano >= proceso.tamano:
                sobrante = p.tamano - proceso.tamano
                if sobrante < min_espacio_sobrante:
                    min_espacio_sobrante = sobrante
                    mejor_particion = p

        if mejor_particion:
            idx = self.particiones.index(mejor_particion)
            if min_espacio_sobrante > 0:
                nueva_libre = Particion(
                    max(part.id for part in self.particiones) + 1,
                    mejor_particion.inicio + proceso.tamano,
                    min_espacio_sobrante
                )
                mejor_particion.tamano = proceso.tamano
                self.particiones.insert(idx + 1, nueva_libre)

            mejor_particion.pid = proceso.pid
            mejor_particion.fragmentacion_interna = 0
            return True
        return False

    def liberar_memoria(self, pid):
        for p in self.particiones:
            if p.pid == pid:
                p.pid = None
                p.fragmentacion_interna = 0
        
        # Fusionar particiones libres adyacentes para evitar fragmentación externa
        i = 0
        while i < len(self.particiones) - 1:
            if self.particiones[i].pid is None and self.particiones[i+1].pid is None:
                self.particiones[i].tamano += self.particiones[i+1].tamano
                self.particiones.pop(i+1)
            else:
                i += 1

    def ejecutar_ciclo(self):
        # 1. Registrar las llegadas para que permanezcan visibles en NUEVO este ciclo.
        procesos_que_llegan_ahora = []
        for p in self.procesos:
            if (
                p.arribo == self.tiempo_actual
                and p.estado == "Nuevo"
                and p not in self.cola_nuevo
                and p not in self.cola_listo
                and p not in self.cola_listo_suspendido
                and p not in self.cola_terminado
                and p is not self.proceso_ejecucion
            ):
                self.cola_nuevo.append(p)
                procesos_que_llegan_ahora.append(p)
                print(
                    f"[LLEGADA] El proceso {p.pid} llega en T={self.tiempo_actual} "
                    f"(tamaño: {p.tamano} KB, CPU: {p.irrupcion}). "
                    "Ingresa a la cola NUEVO."
                )

        # 2. Admitir procesos que ya estaban en NUEVO antes de este ciclo.
        while self.cola_nuevo:
            if self.cola_nuevo[0] in procesos_que_llegan_ahora:
                break

            if self.grado_multiprogramacion_activo() >= 5:
                print(
                    "[ADMISIÓN] Se alcanzó el límite de multiprogramación (5). "
                    "Los procesos restantes permanecen en la cola NUEVO."
                )
                break

            proc = self.cola_nuevo[0]
            if self.asignar_memoria_best_fit(proc):
                self.cola_nuevo.pop(0)
                proc.estado = "Listo"
                self.cola_listo.append(proc)
                print(
                    f"[ADMISIÓN] El proceso {proc.pid} sale de NUEVO, "
                    "obtiene memoria mediante Best-Fit y pasa a LISTOS."
                )
            else:
                self.cola_nuevo.pop(0)
                proc.estado = "Listo/Suspendido"
                self.cola_listo_suspendido.append(proc)
                print(
                    f"[MEMORIA] El proceso {proc.pid} sale de NUEVO, pero no hay "
                    "un bloque contiguo suficiente; pasa a LISTOS/SUSPENDIDOS."
                )

        # 2.1 Intentar reubicar suspendidos si hay memoria libre
        i = 0
        while i < len(self.cola_listo_suspendido) and self.grado_multiprogramacion_activo() < 5:
            proc = self.cola_listo_suspendido[i]
            if self.asignar_memoria_best_fit(proc):
                self.cola_listo_suspendido.pop(i)
                proc.estado = "Listo"
                self.cola_listo.append(proc)
                print(
                    f"[REINGRESO] El proceso {proc.pid} obtiene memoria libre "
                    "y pasa de LISTOS/SUSPENDIDOS a LISTOS."
                )
            else:
                i += 1

        # 3. Planificación de CPU - SRTF (Shortest Remaining Time First)
        candidatos = self.cola_listo.copy()
        if self.proceso_ejecucion:
            candidatos.append(self.proceso_ejecucion)

        if candidatos:
            # SRTF elige la menor CPU restante; en empate, conserva el criterio de llegada.
            candidatos.sort(key=lambda x: (x.restante, x.arribo))
            seleccionado = candidatos[0]

            if self.proceso_ejecucion and self.proceso_ejecucion.pid != seleccionado.pid:
                proceso_desalojado = self.proceso_ejecucion
                print(
                    f"[SRTF - DESALOJO] El proceso {seleccionado.pid} "
                    f"(CPU restante: {seleccionado.restante}) desaloja al proceso "
                    f"{proceso_desalojado.pid} "
                    f"(CPU restante: {proceso_desalojado.restante}), porque "
                    f"{seleccionado.pid} necesita menos tiempo de CPU."
                )
                self.proceso_ejecucion.estado = "Listo"
                if self.proceso_ejecucion not in self.cola_listo:
                    self.cola_listo.append(self.proceso_ejecucion)
                self.cola_listo.remove(seleccionado)
                self.proceso_ejecucion = seleccionado
                self.proceso_ejecucion.estado = "Ejecución"
            elif not self.proceso_ejecucion:
                self.cola_listo.remove(seleccionado)
                self.proceso_ejecucion = seleccionado
                self.proceso_ejecucion.estado = "Ejecución"
                print(
                    f"[CPU - SRTF] La CPU estaba libre. El proceso {seleccionado.pid} "
                    f"ingresa desde LISTOS con {seleccionado.restante} unidades "
                    "de CPU restantes."
                )
            elif len(candidatos) > 1:
                print(
                    f"[SRTF] Continúa {seleccionado.pid} en la CPU: tiene el menor "
                    f"tiempo restante ({seleccionado.restante}) entre los procesos "
                    "listos y el que estaba ejecutándose."
                )
        else:
            print("[CPU] No hay procesos listos para ejecutar; la CPU queda inactiva.")

        # 4. Ejecución del proceso actual en CPU
        if self.proceso_ejecucion:
            if self.proceso_ejecucion.tiempo_comienzo == -1:
                self.proceso_ejecucion.tiempo_comienzo = self.tiempo_actual
                print(
                    f"[EJECUCIÓN] Comienza el proceso {self.proceso_ejecucion.pid} "
                    f"con {self.proceso_ejecucion.restante} unidades de CPU."
                )
            
            self.proceso_ejecucion.restante -= 1
            print(
                f"[EJECUCIÓN] El proceso {self.proceso_ejecucion.pid} utiliza "
                f"1 unidad de CPU; le quedan {self.proceso_ejecucion.restante}."
            )

            # Incrementar tiempo de espera para los que están en listas de listos
            for p in self.cola_listo:
                p.espera += 1

        # 5. Comprobar si el proceso en ejecución finalizó
        if self.proceso_ejecucion and self.proceso_ejecucion.restante == 0:
            p_term = self.proceso_ejecucion
            p_term.estado = "Terminado"
            p_term.retorno = self.tiempo_actual + 1 - p_term.arribo
            print(
                f"[FINALIZACIÓN] El proceso {p_term.pid} completó su ejecución, "
                "pasa a TERMINADOS y libera su memoria."
            )
            self.liberar_memoria(p_term.pid)
            self.cola_terminado.append(p_term)
            self.proceso_ejecucion = None

    def mostrar_salida(self):
        print(f"\n==================================================")
        print(f"               TIEMPO T = {self.tiempo_actual}")
        print(f"==================================================")
        proceso_actual = self.proceso_ejecucion.pid if self.proceso_ejecucion else 'Inactivo (Idle)'
        print(f"Estado del Procesador (Ejecución): {proceso_actual}")
        
        print("\n[Tabla de Particiones de Memoria (MVT)]")
        print(f"{'ID':<5} {'Dir. Inicio':<12} {'Tamaño (KB)':<12} {'Estado/PID':<18} {'Descripción'}")
        print("-" * 75)
        for part in self.particiones:
            if part.pid is None:
                estado_str = "LIBRE"
                descripcion = "Espacio vacío/restante"
            else:
                estado_str = f"Ocupado ({part.pid})"
                descripcion = f"Asignado al proceso {part.pid}"
            print(f"{part.id:<5} {part.inicio:<12} {part.tamano:<12} {estado_str:<18} {descripcion}")

        print("\n[Estado de las Colas]")
        print(f"Cola de NUEVO:               {[p.pid for p in self.cola_nuevo]}")
        print(f"Cola de LISTOS:              {[p.pid for p in self.cola_listo]}")
        print(f"Cola de LISTOS/SUSPENDIDOS:  {[p.pid for p in self.cola_listo_suspendido]}")
        print(f"Cola de TERMINADOS:          {[p.pid for p in self.cola_terminado]}")
        print("=" * 75)

    def iniciar_simulacion(self):
        while len(self.cola_terminado) < len(self.procesos):
            self.ejecutar_ciclo()
            self.mostrar_salida()
            self.tiempo_actual += 1
            input("Presione [Enter] para avanzar al siguiente ciclo...")

        self.mostrar_informe_estadistico()

    def mostrar_informe_estadistico(self):
        print("\n" + "="*50)
        print("           INFORME ESTADÍSTICO FINAL")
        print("="*50)
        print(f"{'Proceso':<10} {'T. Retorno':<12} {'T. Espera':<10}")
        
        t_retorno_total = 0
        t_espera_total = 0
        
        for p in self.cola_terminado:
            print(f"{p.pid:<10} {p.retorno:<12} {p.espera:<10}")
            t_retorno_total += p.retorno
            t_espera_total += p.espera
            
        n = len(self.procesos)
        print("-" * 50)
        if n == 0:
            print("No hay procesos cargados. Agregue procesos a procesos.txt.")
            print("="*50)
            return
        print(f"Tiempo Promedio de Retorno: {t_retorno_total / n:.2f}")
        print(f"Tiempo Promedio de Espera: {t_espera_total / n:.2f}")
        rendimiento = n / self.tiempo_actual
        print(f"Rendimiento del Sistema (Throughput): {rendimiento:.2f} procesos/unidad de tiempo")
        print("="*50)

if __name__ == "__main__":
    sim = Simulador("procesos.txt")
    sim.iniciar_simulacion()